{
  "name": "gyeoltarae",
  "private": true,
  "version": "0.0.0",
  "description": "나무위키 스타일 문법으로 세계관·설정을 정리하는 로컬 위키/메모 앱",
  "author": "결타래",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on tcp:3171 && electron .\"",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:packager": "npm run build && node scripts/package-win.js"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.gyeoltarae.app",
    "productName": "결타래",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
